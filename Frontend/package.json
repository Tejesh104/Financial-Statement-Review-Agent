{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @accessibility",
        "test:component": "vitest run src/tests/components/**/*.test.{js,jsx,ts,tsx}",
        "test:visual": "playwright test --grep @visual",
    "test:functional": "playwright test --grep @functional",
    "test:auth": "playwright test --grep @auth",
    "test:authorization": "playwright test --grep @authorization",
    "test:responsive": "playwright test --grep @responsive",
    "test:api": "playwright test --grep @api"

  },
  "dependencies": {
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "jsdom": "^29.1.1",
    "lighthouse-ci": "^1.13.1",
    "msw": "^2.15.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "puppeteer": "^22.6.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
