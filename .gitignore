# ==================================================
# FINNY — Root .gitignore
# ==================================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
.env.local
.env.production
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# Obsolete / Unused Backend (Preserve active finny-backend only)
Congizant Backend/backend/

# Uploads & Temporary Storage
uploads/
*/uploads/*
!uploads/.gitkeep
!*/uploads/.gitkeep

# Temporary Test PDFs & Outputs
*.pdf
test_direct_report.pdf
test_report.pdf
test_live_report.pdf

# Python Artifacts & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/

# Node / Frontend Artifacts
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs & Debug Outputs
*.log
logs/
debug_output.txt
live_output.txt

# Backup & Local Settings
.git_backup/
*/.git_backup/
*/*/.git_backup/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak
