# ==============================================================================
# FINNY — Master Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (FastAPI - Port 8001 / EC2)
# Location: Congizant Backend/finny-backend/.env
# ------------------------------------------------------------------------------
PORT=8001
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_HOST>:5432/<DB_NAME>
JWT_SECRET_KEY=<REPLACE_WITH_SECURE_RANDOM_SECRET_KEY>
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
ALLOWED_ORIGINS=["https://<YOUR_AMPLIFY_FRONTEND_DOMAIN>"]
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=240

# ------------------------------------------------------------------------------
# FRONTEND (React 19 / Vite 8 - AWS Amplify Hosting)
# Location: Frontend/.env
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://<AWS_BACKEND_API_DOMAIN>/api/v1
VITE_API_URL=http://localhost:8001/api/v1
VITE_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
