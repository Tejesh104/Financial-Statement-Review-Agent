# ==============================================================================
# FINNY Backend — Production & Development Environment Template
# ==============================================================================

# Server Runtime Settings
PORT=8001
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1

# Document Storage & Upload Limit (Max 20MB per document)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# Database Configuration
# Production (AWS RDS PostgreSQL): postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
# Development fallback: sqlite:///./finny.db
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_HOST>:5432/<DB_NAME>

# Security & Cryptographic Tokens
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<REPLACE_WITH_SECURE_RANDOM_SECRET_KEY>

# Google OAuth 2.0 (Public Client ID for token audience verification)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com

# Cross-Origin Resource Sharing (CORS)
# Add your AWS Amplify frontend URL: ["https://<APP_ID>.amplifyapp.com", "https://yourdomain.com"]
ALLOWED_ORIGINS=["https://<YOUR_AMPLIFY_FRONTEND_DOMAIN>"]

# Ollama LLM Configuration (Internal to host - never exposed to public internet)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=240
